diff --git a/src/btop_draw.cpp b/src/btop_draw.cpp
index 1c3b1bc..8dc7d91 100644
--- a/src/btop_draw.cpp
+++ b/src/btop_draw.cpp
@@ -2303,6 +2303,38 @@ namespace Draw {
 		Net::shown = boxes.contains("net");
 		Proc::shown = boxes.contains("proc");
 
+		//* Wide layout: every shown box gets a full height column, spare width is shared out by weight
+		const bool wide_layout = Config::getB("wide_layout");
+		struct Column { int count, min_width, weight, x = 1, width = 0; };
+		Column cpu_col{Cpu::shown, Cpu::min_width, 3}, mem_col{Mem::shown, Mem::min_width, 2};
+		Column net_col{Net::shown, Net::min_width, 2}, proc_col{Proc::shown, Proc::min_width, 3};
+	#ifdef GPU_SUPPORT
+		Column gpu_col{Gpu::shown, Gpu::min_width, 2};
+		const array columns{&cpu_col, &gpu_col, &mem_col, &net_col, &proc_col};
+	#else
+		const array columns{&cpu_col, &mem_col, &net_col, &proc_col};
+	#endif
+		if (wide_layout) {
+			int min_total = 0, weight_total = 0;
+			for (const auto* col : columns) {
+				min_total += col->count * col->min_width;
+				weight_total += col->count * col->weight;
+			}
+			const int extra = max(0, Term::width - min_total);
+			int next_x = 1;
+			Column* last = nullptr;
+			for (auto* col : columns) {
+				if (col->count == 0) continue;
+				col->x = next_x;
+				col->width = col->min_width + extra * col->weight / weight_total;
+				next_x += col->count * col->width;
+				last = col;
+			}
+			//? Hand rounding leftovers to the last column
+			if (last != nullptr and last->count == 1)
+				last->width += max(0, Term::width + 1 - next_x);
+		}
+
 		//* Calculate and draw cpu box outlines
 		if (Cpu::shown) {
 			using namespace Cpu;
@@ -2327,6 +2359,10 @@ namespace Draw {
 		#endif
 			x = 1;
 			y = cpu_bottom ? Term::height - height + 1 : 1;
+			if (wide_layout) {
+				x = cpu_col.x; y = 1;
+				width = cpu_col.width; height = Term::height;
+			}
 
 		#ifdef GPU_SUPPORT
 			b_columns = max(2, (int)ceil((double)(Shared::coreCount + 1) / (height - gpus_extra_height - 5)));
@@ -2410,6 +2446,10 @@ namespace Draw {
 				height += (height+Cpu::height == Term::height-1);
 				height = max(height, b_height_vec[i] + 2);
 				x_vec[i] = 1; y_vec[i] = 1 + total_height + (not Config::getB("cpu_bottom"))*Cpu::shown*Cpu::height;
+				if (wide_layout) {
+					width = gpu_col.width; height = Term::height;
+					x_vec[i] = gpu_col.x + i * gpu_col.width; y_vec[i] = 1;
+				}
 				box[i] = createBox(x_vec[i], y_vec[i], width, height, Theme::c("cpu_box"), true, std::string("gpu") + (char)(shown_panels[i]+'0'), "", (shown_panels[i]+5)%10); // TODO gpu_box
 				b_width = clamp(width/2, min_width, 65);
 				total_height += height;
@@ -2451,6 +2491,10 @@ namespace Draw {
 			else
 				y = cpu_bottom ? 1 : Cpu::height + 1;
 		#endif
+			if (wide_layout) {
+				x = mem_col.x; y = 1;
+				width = mem_col.width; height = Term::height;
+			}
 
 			if (show_disks) {
 				mem_width = ceil((double)(width - 3) / 2);
@@ -2514,6 +2558,11 @@ namespace Draw {
 			else
 				y = Term::height - height + 1 - (cpu_bottom ? Cpu::height : 0);
 
+			if (wide_layout) {
+				x = net_col.x; y = 1;
+				width = net_col.width; height = Term::height;
+			}
+
 			b_width = (width > 45) ? 27 : 19;
 			b_height = (height > 10) ? 9 : height - 2;
 			b_x = x + width - b_width - 1;
@@ -2545,6 +2594,10 @@ namespace Draw {
 			y = (cpu_bottom and Cpu::shown) ? 1 : Cpu::height + 1;
 		#endif
 			select_max = height - 3;
+			if (wide_layout) {
+				x = proc_col.x; y = 1;
+				width = proc_col.width; height = Term::height;
+			}
 			box = createBox(x, y, width, height, Theme::c("proc_box"), true, "proc", "", 4);
 		}
 	}
