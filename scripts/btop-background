#!/bin/bash
# Put btop on the wallpaper, or take it away.
#
# Without a monitor it goes to the wide short screen (a Corsair Xeneon Edge and
# the like) whenever one is connected — that is the screen this is for — and
# only falls back to the focused monitor when there is no such screen.
# The surfaces themselves live in the plugin's Service.qml.

set -euo pipefail

ACTION="${1:-toggle}"
SCREEN="${2:-}"

if [[ -z $SCREEN ]]; then
  SCREEN="$(hyprctl monitors -j | jq -r '
    [.[] | select(((.width / .scale) >= (.height / .scale) * 2.2) or ((.height / .scale) < 600))][0].name
    // [.[] | select(.focused)][0].name
  ')"
fi
[[ -n $SCREEN && $SCREEN != "null" ]] || { echo "btop-background: no monitor to use" >&2; exit 1; }

case "$ACTION" in
  toggle) method="toggleBackground" ;;
  show) method="showBackground" ;;
  hide) method="hideBackground" ;;
  *) echo "Usage: btop-background [toggle|show|hide] [monitor]" >&2; exit 1 ;;
esac

exec omarchy-shell ure.btop "$method" "$SCREEN"
