#!/bin/bash
# Teach the Omarchy bar to skip the screens listed in shell.json's
# bar.hiddenScreens, which is what makes the per-screen bar switches work.
#
# The packaged bar draws on every screen and must never be edited in place, so
# this clones it into the user's own plugins the way Omarchy intends, then
# patches the clone. A bar that already honours the list is left alone.
#
#   bar-support status    prints supported | unsupported | missing
#   bar-support install   clones the stock bar if needed, then patches it

set -euo pipefail

SHELL_JSON="$HOME/.config/omarchy/shell.json"
PLUGIN_DIR="$HOME/.config/omarchy/plugins"
STOCK_BAR="${OMARCHY_PATH:-/usr/share/omarchy}/shell/plugins/bar"

active_bar() {
  local id=""
  [[ -f $SHELL_JSON ]] && id="$(jq -r '.bar.id // ""' "$SHELL_JSON")"
  [[ -n $id && $id != "null" ]] && echo "$id" || echo "omarchy.bar"
}

bar_source() { #? directory holding the active bar's QML
  local id="$1"
  if [[ $id == "omarchy.bar" ]]; then echo "$STOCK_BAR"; else echo "$PLUGIN_DIR/$id"; fi
}

status() {
  local id source
  id="$(active_bar)"
  source="$(bar_source "$id")"
  if [[ ! -f "$source/Bar.qml" ]]; then echo "missing"; return; fi
  if grep -q "hiddenScreens" "$source/Bar.qml"; then echo "supported"; else echo "unsupported"; fi
}

patch_bar() { #? directory of a cloned bar
  python3 - "$1/Bar.qml" <<'PY'
import re, shutil, sys, time

path = sys.argv[1]
source = open(path).read()

if "hiddenScreens" in source:
    print("bar-support: already patched")
    raise SystemExit(0)

#? The property the three screen filters read
declaration = '''  // Output names that show no bar, from shell.json's bar.hiddenScreens. Added
  // by the ure.btop plugin so the bar can be hidden on one screen at a time.
  readonly property var hiddenScreens: {
    var config = Util.isPlainObject(barConfig) ? barConfig : {}
    var list = config.hiddenScreens
    return Array.isArray(list) ? list : []
  }

'''

anchor = "  function applyBarConfig() {"
if anchor not in source:
    raise SystemExit("bar-support: cannot find applyBarConfig() in " + path)
source = source.replace(anchor, declaration + anchor, 1)

#? Every per-screen Variants model, whether stock or already hand-filtered
pattern = re.compile(r"model: Quickshell\.screens(?:\.filter\([^\n]*\))?")
replacement = "model: Quickshell.screens.filter(screen => !root.hiddenScreens.includes(screen.name))"
source, count = pattern.subn(replacement, source)
if count == 0:
    raise SystemExit("bar-support: cannot find the screen models in " + path)

shutil.copyfile(path, path + ".bak." + str(int(time.time())))
open(path, "w").write(source)
print("bar-support: patched %s (%d screen models)" % (path, count))
PY
}

install() {
  local id source
  id="$(active_bar)"

  if [[ $id == "omarchy.bar" ]]; then
    echo "bar-support: cloning the stock bar so it can be patched"
    omarchy plugin clone omarchy.bar
    id="$(active_bar)"
    [[ $id != "omarchy.bar" ]] || { echo "bar-support: the clone did not become the active bar" >&2; exit 1; }
  fi

  source="$(bar_source "$id")"
  [[ -f "$source/Bar.qml" ]] || { echo "bar-support: no Bar.qml in $source" >&2; exit 1; }
  patch_bar "$source"

  #? Keep whatever the bar skipped before; an empty list is a fine starting point
  if [[ -f $SHELL_JSON ]] && ! jq -e '.bar.hiddenScreens' "$SHELL_JSON" >/dev/null 2>&1; then
    local updated
    updated="$(jq '.bar.hiddenScreens = []' "$SHELL_JSON")"
    printf '%s\n' "$updated" > "$SHELL_JSON.tmp"
    chmod 600 "$SHELL_JSON.tmp"
    mv "$SHELL_JSON.tmp" "$SHELL_JSON"
  fi

  echo "bar-support: the bar now follows bar.hiddenScreens (restart the shell to load it)"
}

case "${1:-status}" in
  status) status ;;
  install) install ;;
  *) echo "Usage: bar-support [status|install]" >&2; exit 1 ;;
esac
